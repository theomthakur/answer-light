# --- AI provider -----------------------------------------------------------
# Default provider is Google Gemini (free tier, no credit card).
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The Vercel AI SDK's Google provider also reads this name; either works.
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional: swap the whole pipeline to Claude (Glade-native) -------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-6   # override the default model id for a provider
